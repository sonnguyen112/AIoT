# Never commit .env; chmod 600 .env. Laptop settings:
TELEGRAM_BOT_TOKEN=
# Numeric IDs separated by commas. Empty = open access (user-selected MVP mode).
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=edgeface_bot
MQTT_PASSWORD=
# Keep loopback with Tailscale Serve; expose TCP 1883 within the tailnet only.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_DEVICE_PASSWORD=
MQTT_MONITOR_PASSWORD=
MQTT_EXPLORER_USERNAME=admin
MQTT_EXPLORER_PASSWORD=
MQTT_EXPLORER_PORT=4000
DEVICE_ID=raspberrypi-01
TOPIC_PREFIX=aiot/edgeface
COMMAND_TIMEOUT_S=15
COMMAND_TTL_S=60
NOTIFICATION_COOLDOWN_S=30
AUTO_STOP_ON_KNOWN=true
# Opt-in: recognized-member text + annotated photo to the chat that sent /start.
# Pi HTTP binds its own Tailscale IP; never bind a public interface.
RECOGNITION_PHOTO_ENABLED=false
SNAPSHOT_TOKEN=
SNAPSHOT_BASE_URL=
SNAPSHOT_BIND=127.0.0.1
SNAPSHOT_PORT=8765
SNAPSHOT_TTL_S=120
SNAPSHOT_TIMEOUT_S=5
SNAPSHOT_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Pi .env: MQTT_HOST is the WSL Tailscale IPv4; username edgeface_pi.
DATASET_DIR=dataset
MODEL_DIR=models/active
DISPLAY_NAMES_PATH=configs/display_names.json
DETECTOR_PATH=models/face_detection_yunet_2023mar.onnx
CAMERA_BACKEND=auto
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FRAME_INTERVAL_S=0.15
ORT_THREADS=2
# Optional Pi runtime override; empty uses the validation-calibrated bundle threshold.
# Manual demo setting: REJECTION_THRESHOLD=0.9 (does not change historical evaluation).
REJECTION_THRESHOLD=
COLLECTION_TARGET=150
COLLECTION_INTERVAL_S=0.5
COLLECTION_MAX_SECONDS=600
MIN_FACE_SIZE=80
MIN_BLUR_VARIANCE=60
MIN_BRIGHTNESS=35
MAX_BRIGHTNESS=220
DUPLICATE_HAMMING=4
TELEMETRY_INTERVAL_S=10
NO_FACE_AFTER_S=8
AUDIO_ENABLED=false
AUDIO_LANGUAGE=vi
PI_HOST=pi@raspberrypi.local
PI_DIR=/home/pi/edgeface
